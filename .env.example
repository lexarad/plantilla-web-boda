# ============================================================================
# Variables de entorno de la web de la boda
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA pongas valores reales en este archivo (se sube a git).
# Las que empiezan por NEXT_PUBLIC_ son visibles en el navegador (no pongas secretos ahí).
# ============================================================================

# --- Supabase (base de datos, login y almacenamiento) ---
# URL del proyecto Supabase. Supabase > Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública anónima de Supabase. Supabase > Settings > API > Project API keys > anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Acceso de administradores ---
# Emails que pueden entrar al panel de administración, separados por comas. Deben coincidir con los de supabase/schema.sql (función is_wedding_admin).
# Ejemplo: ADMIN_EMAILS=novio1@example.com,novio2@example.com
ADMIN_EMAILS=

# --- Envío de emails (Resend) ---
# Clave de API de Resend para enviar correos. resend.com > API Keys > Create API Key.
RESEND_API_KEY=
# Remitente de los correos. Debe usar un dominio verificado en Resend (ej: invitaciones@tudominio.es).
# Sin dominio propio, Resend solo deja enviar desde onboarding@resend.dev y solo a tu propio email.
RESEND_FROM_EMAIL=

# --- URL pública del sitio ---
# Dirección final de la web. En local déjala en localhost; en producción usa la URL de Vercel o tu dominio. En Vercel no es obligatoria (se usa VERCEL_URL automática).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron diario que mantiene despierto Supabase ---
# Opcional. Protege /api/cron/keepalive: si lo defines, añádelo también en Vercel
# (Settings > Environment Variables) y solo el cron de Vercel podrá llamarlo.
CRON_SECRET=

# --- Datos de la boda (visibles en la web pública) ---
# IBAN de la cuenta para regalos/transferencias.
NEXT_PUBLIC_WEDDING_IBAN=
# Titular de la cuenta del IBAN (nombre que aparece en el banco).
NEXT_PUBLIC_WEDDING_IBAN_HOLDER=
# Concepto sugerido para las transferencias (ej: Boda A&S + tu nombre).
NEXT_PUBLIC_WEDDING_IBAN_CONCEPT=
# Teléfono de contacto para los invitados.
NEXT_PUBLIC_WEDDING_PHONE=
# Email de contacto para los invitados.
NEXT_PUBLIC_WEDDING_EMAIL=
# Texto con sugerencias de hoteles/alojamiento para los invitados.
NEXT_PUBLIC_WEDDING_HOTELS=
